// MyStrategy - coordinator agent
// Factory builds everything, here just lookup + tell robots what to do
// TODO: still sequential, one transfer at a time
agent MyStrategy extends core.Base {

    // configList: names read from factory artifact
    // idle(r): robot free for work
    types strategy {
        formula configList(string, list);
        formula idle(string);
        formula failed(string, string);
    }

    initial !start();

    plan +!start() {
        cartago.link();

        // artifacts already exist, only lookup
        !floorplan(cartago.ArtifactId _);
        !warehouse(cartago.ArtifactId _);
        !orders(cartago.ArtifactId _);

        !loadConfig();

        // all robots start idle
        ?configList("robots", list robots);
        forall (string r : robots) {
            !robot(r, cartago.ArtifactId _);
            +idle(r);
        }
        cartago.println("[S] idle robots = " + robots);

        !fulfilOrders();
    }

    // read names from config so nothing is hardcoded
    plan +!loadConfig() {
        cartago.lookupArtifact("factory", cartago.ArtifactId fid);

        cartago.operation(fid, observeProperty("warehouse", cartago.ArtifactObsProperty p1));
        +configList("warehouse", pe.listValues(p1));

        cartago.operation(fid, observeProperty("accessPoints", cartago.ArtifactObsProperty p2));
        +configList("accessPoints", pe.listValues(p2));

        cartago.operation(fid, observeProperty("storagePoints", cartago.ArtifactObsProperty p3));
        +configList("storagePoints", pe.listValues(p3));

        cartago.operation(fid, observeProperty("packagingPoints", cartago.ArtifactObsProperty p4));
        +configList("packagingPoints", pe.listValues(p4));

        cartago.operation(fid, observeProperty("workstations", cartago.ArtifactObsProperty p5));
        +configList("workstations", pe.listValues(p5));

        cartago.operation(fid, observeProperty("robots", cartago.ArtifactObsProperty p6));
        +configList("robots", pe.listValues(p6));

        cartago.println("[S] accessPoints = " + pe.listValues(p2));
        cartago.println("[S] packagingPoints = " + pe.listValues(p4));
        cartago.println("[S] workstations = " + pe.listValues(p5));
        cartago.println("[S] robots = " + pe.listValues(p6));
    }

    plan +?configList(string property, list values) : configList(property, values) { }

    // main loop
    // waiting==0 but coming>0 -> orders not arrived yet, so wait
    plan +!fulfilOrders() {
        ?outstandingOrders(int waiting);
        ?ordersToArrive(int coming);
        int remaining = waiting + coming;
        cartago.println("[S] orders to do = " + remaining);

        while (remaining > 0) {
            if (waiting == 0) {
                S.sleep(1000);
            } else {
                !fulfilOne();
            }
            ?outstandingOrders(int w2);
            ?ordersToArrive(int c2);
            waiting = w2;
            remaining = w2 + c2;
        }
        cartago.println("[S] all orders delivered");
    }

    // one order: assign, make items, deliver
    // only first pp for now
    plan +!fulfilOne() : configList("packagingPoints", list pps) {
        string pp = P.headAsString(pps);
        !packagingPoint(pp, cartago.ArtifactId _);

        !assign(pp, string orderId);
        cartago.println("[S] order " + orderId + " assigned to " + pp);

        !produceAll(pp);

        !deliver(pp);  // not automatic!
        cartago.println("[S] order " + orderId + " delivered at " + pp);
    }

    // keep going until pp has everything
    plan +!produceAll(string pp) {
        ?outstanding(pp, list needed);
        while (P.size(needed) > 0) {
            !produceOne(pp);
            ?outstanding(pp, list needed2);
            needed = needed2;
        }
    }

    // fetch inputs -> operate -> carry output to pp
    // just uses first ws / ap
    plan +!produceOne(string pp) :
            configList("workstations", list wss) & configList("accessPoints", list aps) {
        string ws = P.headAsString(wss);
        string ap = P.headAsString(aps);
        !workstation(ws, cartago.ArtifactId _);
        !accessPoint(ap, cartago.ArtifactId _);

        ?inputsNeeded(ws, list missing);
        while (P.size(missing) > 0) {
            string item = P.headAsString(missing);

            ?idle(string r);
            -idle(r);   // take it so nobody else gets it
            !available(ap, item);
            !transfer(r, ap, ws);
            +idle(r);
            ?inputsNeeded(ws, list missing2);
            missing = missing2;
        }

        !operate(ws);  // blocks till done

        ?idle(string r);
        -idle(r);
        !transfer(r, ws, pp);
        +idle(r);
    }

    // has to be a query plan - binding in a goal's guard didn't come back out
    plan +?idle(string r) : idle(r) { }

    // send request then wait for reply or failure
    // (supplied version could hang forever here)
    plan +!transfer(string name, string from, string to) {
        send(request, name, transfer(from, to));
        wait(transferred(from, to) | failed(from, to));

        if (failed(from, to)) {
            -failed(from, to);
            -transferred(from, to);
            cartago.println("[S] transfer " + from + " -> " + to + " by " + name + " FAILED");
            S.fail();
        } else {
            -transferred(from, to);
        }
    }

    plan @message(inform, string sender, transferred(string from, string to)) {
        +transferred(from, to);
    }

    plan @message(failure, string sender, transfer(string from, string to)) {
        cartago.println("[S] " + sender + " reported failure: " + from + " -> " + to);
        +failed(from, to);
    }
}
